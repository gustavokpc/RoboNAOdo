            <Box name="LLM_CHAT" id="3" localization="8" tooltip="" x="632" y="49">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4">
                <content>
                  <![CDATA[# -*- coding: utf-8 -*-
# Choregraphe NAOqi 2.8 / Python 2.7
# INPUTS: onStart, onStop, onResume (onEvent, bang)
# OUTPUTS: onDance, onEmotion (both punctual, bang)
# CONNECTIONS:
#   LLM_CHAT.onDance  -> LLM_DANCE.onStart
#   LLM_DANCE.onStopped -> LLM_CHAT.onResume
#   LLM_CHAT.onEmotion -> TESTE.onStart
import socket
import threading

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        self.running = False
        self.server = None
        self.worker = None
        self.generation = 0
        self.waiting_dance = False
        self.dance_timeout = False
        self.dance_done = threading.Event()
        self.tts = ALProxy("ALTextToSpeech")
        self.tts.setLanguage("English")

    def _close_server(self):
        server = self.server
        self.server = None
        if server is not None:
            try:
                server.close()
            except Exception:
                pass

    def onInput_onStart(self):
        if self.running:
            self.logger.info("LLM_CHAT already running")
            return
        self.generation += 1
        generation = self.generation
        self.running = True
        self.waiting_dance = False
        self.dance_timeout = False
        self.dance_done.clear()
        self.worker = threading.Thread(target=self._listen, args=(generation,))
        self.worker.daemon = True
        self.worker.start()

    def onInput_onResume(self):
        if not self.waiting_dance:
            self.logger.warning("onResume received, but no dance was pending")
            return
        self.logger.info("DANCE_DONE: animation returned through onResume")
        self.dance_done.set()
        generation = self.generation
        th = threading.Thread(target=self._finish_dance, args=(generation,))
        th.daemon = True
        th.start()

    def _finish_dance(self, generation):
        try:
            if self.running and generation == self.generation:
                self.tts.say("That was fun! What should we do next?")
        except Exception as e:
            self.logger.warning("Speech after dance failed: %s" % e)
        finally:
            if generation == self.generation:
                self.waiting_dance = False
                self.dance_timeout = False
                self.logger.info("LLM_CHAT READY: conversation resumed")

    def _dance_watchdog(self, generation):
        if not self.dance_done.wait(90.0):
            if (generation == self.generation and
                    self.running and self.waiting_dance):
                self.dance_timeout = True
                self.logger.error(
                    "DANCE_TIMEOUT: missing LLM_DANCE.onStopped -> LLM_CHAT.onResume?"
                )
        # Do not pretend a dance is finished just because the timeout elapsed.

    def _dispatch_dance(self, generation):
        try:
            if self.running and generation == self.generation:
                self.logger.info("DANCE_START: activating onDance output")
                self.onDance()
        except Exception as e:
            self.logger.error("Could not dispatch onDance: %s" % e)
            if generation == self.generation:
                self.waiting_dance = False
                self.dance_done.set()

    def _send_ack(self, conn, text):
        try:
            conn.sendall(text.encode("ascii"))
        except Exception as e:
            self.logger.warning("Sending ACK failed: %s" % e)

    def _handle(self, conn):
        conn.settimeout(12)
        blocks = []
        total = 0
        while True:
            packet = conn.recv(4096)
            if not packet:
                break
            total += len(packet)
            if total > 16000:
                self._send_ack(conn, "ERROR:MESSAGE_TOO_LONG")
                return
            blocks.append(packet)
        message = b"".join(blocks).decode("utf-8").strip()
        if not message:
            self._send_ack(conn, "ERROR:EMPTY")
            return

        if message == "CMD:STATUS":
            if self.dance_timeout:
                status = "DANCE_TIMEOUT"
            elif self.waiting_dance:
                status = "DANCING"
            else:
                status = "READY" if self.running else "OFFLINE"
            self._send_ack(conn, status)
            return

        if message == "CMD:DANCE":
            if self.waiting_dance:
                self._send_ack(conn, "ERROR:BUSY")
                return
            self.waiting_dance = True
            self.dance_timeout = False
            self.dance_done.clear()
            try:
                self.tts.say("Sure! Let's dance!")
            except Exception as e:
                self.waiting_dance = False
                self._send_ack(conn, "ERROR:TTS_FAILED")
                self.logger.error("TTS before dance failed: %s" % e)
                return
            generation = self.generation
            # ACK now means 'command accepted', NOT 'dance finished'.
            # Never block the TCP listener waiting for the choreography.
            self._send_ack(conn, "OK")
            dispatch = threading.Thread(
                target=self._dispatch_dance, args=(generation,))
            dispatch.daemon = True
            dispatch.start()
            monitor = threading.Thread(
                target=self._dance_watchdog, args=(generation,))
            monitor.daemon = True
            monitor.start()
            return

        if message == "CMD:EMOTION":
            if self.waiting_dance:
                self._send_ack(conn, "ERROR:BUSY")
                return
            self.logger.info("LLM requested TESTE emotion mode")
            self.tts.say("Alright! Let's recognize your emotions.")
            self._send_ack(conn, "OK")
            self.running = False
            self._close_server()
            self.onEmotion()
            return

        if self.waiting_dance:
            self._send_ack(conn, "ERROR:BUSY")
            return
        if message.startswith("SAY:"):
            message = message[4:].strip()
        if not message:
            self._send_ack(conn, "ERROR:EMPTY")
            return
        self.logger.info("LLM talking (%d chars)" % len(message))
        self.tts.say(message.encode("utf-8"))
        self._send_ack(conn, "OK")

    def _listen(self, generation):
        listener = None
        try:
            listener = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            listener.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            listener.bind(("0.0.0.0", 6001))
            listener.listen(8)
            listener.settimeout(1.0)
            if generation != self.generation or not self.running:
                return
            self.server = listener
            self.logger.info("LLM_CHAT ready on TCP port 6001")
            self.tts.say("I am ready to chat. Ask me anything!")
            while self.running and self.generation == generation:
                try:
                    conn, addr = listener.accept()
                except socket.timeout:
                    continue
                except socket.error:
                    if not self.running or self.generation != generation:
                        break
                    raise
                try:
                    self._handle(conn)
                except Exception as e:
                    self.logger.error("LLM_CHAT command error: %s" % e)
                    self._send_ack(conn, "ERROR:COMMAND_FAILED")
                finally:
                    try:
                        conn.close()
                    except Exception:
                        pass
        except Exception as e:
            self.logger.error("LLM_CHAT server error: %s" % e)
        finally:
            if listener is not None:
                try:
                    listener.close()
                except Exception:
                    pass
            if self.generation == generation:
                self.running = False
                if self.server is listener:
                    self.server = None

    def onInput_onStop(self):
        self.onUnload()
        self.onStopped()

    def onUnload(self):
        self.running = False
        self.generation += 1
        self.dance_done.set()
        self.waiting_dance = False
        self._close_server()]]>
                </content>
              </script>
              <Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" />
              <Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" />
              <Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" />
              <Input name="onResume" type="1" type_size="1" nature="1" inner="0" tooltip="" id="4" />
              <Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="5" />
              <Output name="onDance" type="1" type_size="1" nature="2" inner="0" tooltip="" id="6" />
              <Output name="onEmotion" type="1" type_size="1" nature="2" inner="0" tooltip="" id="7" />
            </Box>
            <Box name="SELECT_MODE" id="4" localization="8" tooltip="" x="258" y="174">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4">
                <content>
                  <![CDATA[
import time

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        self.running = False
        self.subscribed = False
        self.context_pushed = False
        self.nome = "SelectModeVoice"

        self.tts = ALProxy("ALTextToSpeech")
        self.asr = ALProxy("ALSpeechRecognition")
        self.memory = ALProxy("ALMemory")

        self.tts.setLanguage("English")
        self.tempo_escuta = 10
        self.confianca_min = 0.45

    def _parar_escuta(self):
        if self.subscribed:
            try:
                self.asr.unsubscribe(self.nome)
            except Exception as e:
                self.logger.warning(str(e))
            self.subscribed = False

        if self.context_pushed:
            try:
                self.asr.popContexts()
            except Exception as e:
                self.logger.warning(str(e))
            self.context_pushed = False

    def _ouvir_resposta(self):
        resposta = None

        try:
            self.asr.pushContexts()
            self.context_pushed = True

            self.asr.setLanguage("English")
            self.asr.setVocabulary(["yes", "no"], False)

            self.memory.insertData(
                "WordRecognized", ["", 0.0]
            )

            self.asr.subscribe(self.nome)
            self.subscribed = True

            self.logger.info("Listening for YES or NO")

            inicio = time.time()

            while self.running:
                if time.time() - inicio > self.tempo_escuta:
                    break

                dados = self.memory.getData("WordRecognized")

                if dados and len(dados) >= 2:
                    palavra = str(dados[0]).lower().strip()
                    confianca = float(dados[1])

                    if palavra in ("yes", "no"):
                        if confianca >= self.confianca_min:
                            resposta = palavra
                            self.logger.info(
                                "Recognized: %s (%.0f%%)" %
                                (palavra, confianca * 100)
                            )
                            break

                time.sleep(0.1)

        finally:
            self._parar_escuta()

        return resposta

    def onInput_onStart(self):
        if self.running:
            return

        self.running = True

        try:
            self.tts.say(
                "Hello! Would you like me to "
                "recognize your emotions? "
                "Please say yes or no."
            )

            resposta = self._ouvir_resposta()

            if resposta is None and self.running:
                self.tts.say(
                    "Sorry, I did not hear you. "
                    "Please say yes or no."
                )
                resposta = self._ouvir_resposta()

            if not self.running:
                return

            if resposta == "yes":
                self.logger.info("Mode: EMOTION")
                self.tts.say(
                    "Great! Let's recognize your emotions!"
                )
                self._parar_escuta()
                self.onTESTE()

            elif resposta == "no":
                self.logger.info("Mode: LLM")
                self.tts.say(
                    "Alright! Let's have a conversation!"
                )
                self._parar_escuta()
                self.onLLM()

            else:
                self.logger.warning("No valid answer received")
                self.tts.say(
                    "I could not understand your answer. "
                    "Please restart to try again."
                )

        except Exception as e:
            self.logger.error("SELECT_MODE error: %s" % e)

        finally:
            self._parar_escuta()
            self.running = False

    def onInput_onStop(self):
        self.running = False
        self._parar_escuta()

    def onUnload(self):
        self.running = False
        self._parar_escuta()]]>
                </content>
              </script>
