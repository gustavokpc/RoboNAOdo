            <Box name="HighFive" id="2" localization="8" tooltip="" x="1390" y="470">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4">
                <content>
                  <![CDATA[import time

class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)

    def onLoad(self):
        self.motion = ALProxy("ALMotion")
        self.memory = ALProxy("ALMemory")
        self.tts    = ALProxy("ALTextToSpeech")
        self.espera = 10   # segundos esperando o toque

        # sensores da mao direita (eventos + valores brutos)
        self.SENSORES = [
            "HandRightBackTouched",
            "HandRightLeftTouched",
            "HandRightRightTouched",
            "Device/SubDeviceList/RHand/Touch/Back/Sensor/Value",
            "Device/SubDeviceList/RHand/Touch/Left/Sensor/Value",
            "Device/SubDeviceList/RHand/Touch/Right/Sensor/Value",
        ]

    def onUnload(self):
        pass

    def _tocou(self):
        for chave in self.SENSORES:
            try:
                v = self.memory.getData(chave)
                if v is not None and float(v) > 0.5:
                    self.logger.info("Toque detectado em: " + chave)
                    return True
            except Exception:
                pass
        return False

    def _respiracao(self, ligar):
        """Liga/desliga os movimentos automaticos dos bracos."""
        try:
            self.motion.setBreathEnabled("Arms", ligar)
        except Exception:
            pass
        try:
            self.motion.setIdlePostureEnabled("Arms", ligar)
        except Exception:
            pass

    def onInput_onStart(self):
        self.memory.insertData("HighFive/OK", 0)
        nomes = ["RShoulderPitch", "RShoulderRoll", "RElbowYaw", "RElbowRoll", "RWristYaw"]
        braco_cima = [-0.9, -0.2, 1.4, 0.2, 1.5]
        descanso   = [1.4, -0.15, 1.2, 0.5, 0.0]

        self._respiracao(False)
        try:
            self.motion.setStiffnesses("RArm", 1.0)
            # angleInterpolation ESPERA o braco chegar la em cima
            self.motion.angleInterpolationWithSpeed(nomes, braco_cima, 0.3)
            self.motion.openHand("RHand")
            self.tts.say("Touch the back of my hand!")

            inicio = time.time()
            tocou = False
            while time.time() - inicio < self.espera:
                if self._tocou():
                    tocou = True
                    break
                time.sleep(0.05)

            if tocou:
                self.memory.insertData("HighFive/OK", 1)
                self.tts.say("Yeah! High five!")
            else:
                self.logger.info("Nenhum toque em %d s" % self.espera)
                self.tts.say("Maybe next time")

            self.motion.closeHand("RHand")
            self.motion.angleInterpolationWithSpeed(nomes, descanso, 0.3)
        except Exception as e:
            self.logger.error("Erro no high five: %s" % e)
        finally:
            self._respiracao(True)
            self.onStopped()

    def onInput_onStop(self):
        self._respiracao(True)
        self.onStopped()]]>
                </content>
              </script>
              <Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" />
              <Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" />
              <Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" />
              <Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" />
            </Box>
