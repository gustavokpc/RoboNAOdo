              <Output name="onSaxophone" type="1" type_size="1" nature="2" inner="0" tooltip="" id="6" />
              <Output name="onThinking" type="1" type_size="1" nature="2" inner="0" tooltip="" id="7" />
              <Output name="onTaiChi" type="1" type_size="1" nature="2" inner="0" tooltip="" id="8" />
              <Output name="onHighFive" type="1" type_size="1" nature="2" inner="0" tooltip="" id="9" />
              <Output name="onCelebrate" type="1" type_size="1" nature="2" inner="0" tooltip="" id="10" />
              <Output name="onLLM" type="1" type_size="1" nature="2" inner="0" tooltip="" id="11" />
            </Box>
            <Box name="Tai Chi Chuan" id="9" localization="8" tooltip="Arms part of Tai Chi Chuan dance." x="1388" y="631">
