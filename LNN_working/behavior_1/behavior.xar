<?xml version="1.0" encoding="UTF-8" ?>
<ChoregrapheProject xmlns="http://www.ald.softbankrobotics.com/schema/choregraphe/project.xsd" xar_version="3">
  <Box name="root" id="-1" localization="8" tooltip="Root box of Choregraphe&apos;s behavior. Highest level possible." x="0" y="0">
    <bitmap>media/images/box/root.png</bitmap>
    <script language="4">
      <content>
        <![CDATA[]]>
      </content>
    </script>
    <Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" />
    <Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" />
    <Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" />
    <Output name="onStopped" type="1" type_size="1" nature="1" inner="0" tooltip="Signal sent when box behavior is finished." id="4" />
    <Timeline enable="0">
      <BehaviorLayer name="behavior_layer1">
        <BehaviorKeyframe name="keyframe1" index="1">
          <Diagram scale="59.4604">
            <Box name="TESTE" id="1" localization="8" tooltip="" x="991" y="315">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4">
                <content>
                  <![CDATA[import time, socket, subprocess
class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)
    def onLoad(self):
        self.running = False
        self.esperando_anim = False
        self.cap = None
        self.sock = None
        self.servidor = None
        self.nome = "TesteEmocao"
        self.ir_para_llm = False  # sinal de troca de modo
        self.tts    = ALProxy("ALTextToSpeech")
        self.asr    = ALProxy("ALSpeechRecognition")
        self.memory = ALProxy("ALMemory")
        self.leds   = ALProxy("ALLeds")
        # ===== CONFIGURACOES GERAIS =====
        self.SERVIDOR = "/home/nao/servidor_emocao.py"
        self.LOG_SERV = "/home/nao/servidor.log"
        self.PORTA = 6000
        self.PASTA = "/usr/share/OpenCV/haarcascades/"
        self.estabilidade = 3      # mesma emocao em N frames seguidos
        self.confianca    = 0.50   # confianca minima da CNN
        self.pausa_depois = 3      # descanso (s) depois de cada reacao
        self.tempo_ouvir  = 8      # segundos esperando yes/no
        self.conf_voz     = 0.50   # confianca minima do yes/no
        self.tempo_anim   = 90     # tempo maximo esperando um bloco externo
        # ===== NEUTRAL =====
        self.tempo_neutral = 5    # segundos neutral para oferecer conversa
        self.tolerancia_sem_rosto = 1.5  # evita reset por falhas curtas da deteccao
        # ===== ANGRY =====
        self.cor_calma     = 0x00CC88  # verde-azulado (0x3399FF = azul)
        self.respiracoes   = 3         # quantas vezes inspira/expira
        self.tempo_inspira = 3         # segundos
        self.tempo_expira  = 4         # segundos
        self.max_rodadas   = 2         # max. de rodadas de respiracao
        # tempo minimo (s) entre duas reacoes da MESMA emocao
        self.COOLDOWN = {
            "neutral":   30,
            "happiness": 15,
            "surprise":  10,
            "anger":     15,
            "sadness":   15,
        }
        # ===== FRASES =====
        self.FRASES = {
            "happy":          "You look happy, give me a high five!",
            "happy_fim":      "Let's celebrate!",
            "happy_sem":      "No problem, let's try another time",
            "neutral":        "You look neutral. Would you like to have a conversation with me? Please say yes or no.",
            "surprise":       "You look surprised",
            "surprise2":      "What happened?",
            "angry":          "You look angry. Let's breathe together",
            "inspira":        "Breathe in",
            "expira":         "And breathe out",
            "angry_pergunta": "Do you feel better now?",
            "angry_sim":      "I am glad you feel better",
            "angry_taichi":   "Do you want to do Tai Chi with me?",
            "angry_taichi_s": "Great, follow me",
            "angry_repetir":  "Okay, let's breathe one more time",
            "angry_fim":      "Take your time. I am here for you",
            "sad_pergunta":   "You look sad. Is it right?",
            "sad_sim":        "Ok. I will sing to make you better",
            "sad_nao":        "Okay, I am glad you are fine",
            "nada":           "I did not hear you, but I am here if you need me",
        }
        self.PERMITIDAS = ["neutral", "happiness", "sadness", "surprise", "anger"]
        self.LABELS = ["neutral", "happiness", "surprise", "sadness",
                       "anger", "disgust", "fear", "contempt"]
        self.ultima_reacao = {}
    # ==================== LIMPEZA ====================
    def onUnload(self):
        self.running = False
        self.esperando_anim = False
        self._parar_escuta()
        try:
            self.leds.fadeRGB("FaceLeds", 0xFFFFFF, 0.3)
        except Exception:
            pass
        if self.cap is not None:
            try:
                self.cap.release()
            except Exception:
                pass
            self.cap = None
        if self.sock is not None:
            try:
                self.sock.close()
            except Exception:
                pass
            self.sock = None
        if self.servidor is not None:
            try:
                self.servidor.terminate()
            except Exception:
                pass
            self.servidor = None
    # ==================== BLOCOS EXTERNOS ====================
    def onInput_onResume(self):
        self.esperando_anim = False
        self.logger.info("Bloco externo terminou, retomando")
    def _animar(self, saida, nome):
        """Dispara um bloco externo e espera o onResume."""
        self.logger.info("Iniciando: " + nome)
        self.esperando_anim = True
        inicio = time.time()
        saida()
        while self.running and self.esperando_anim:
            if time.time() - inicio > self.tempo_anim:
                self.logger.warning(nome + " demorou demais, seguindo")
                self.esperando_anim = False
                break
            time.sleep(0.1)
    # ==================== FALA E ESCUTA ====================
    def _falar(self, texto):
        self.logger.info("Robo: " + texto)
        self.tts.say(texto)
    def _parar_escuta(self):
        try:
            self.asr.unsubscribe(self.nome)
        except Exception:
            pass
        try:
            self.asr.popContexts()
        except Exception:
            pass
    def _ouvir_sim_nao(self):
        """Escuta UMA resposta: 'yes', 'no' ou None."""
        resposta = None
        try:
            self.asr.pushContexts()
            self.asr.setLanguage("English")
            self.asr.setVocabulary(["yes", "no"], False)
            self.memory.insertData("WordRecognized", ["", 0.0])
            self.asr.subscribe(self.nome)
            time.sleep(0.5)
            self.memory.insertData("WordRecognized", ["", 0.0])
            inicio = time.time()
            while self.running and time.time() - inicio < self.tempo_ouvir:
                w = self.memory.getData("WordRecognized")
                if w and len(w) >= 2 and w[0] in ("yes", "no"):
                    self.logger.info("Ouviu: %s (%.0f%%)" % (w[0], w[1] * 100))
                    if w[1] >= self.conf_voz:
                        resposta = w[0]
                        break
                    self.memory.insertData("WordRecognized", ["", 0.0])
                time.sleep(0.1)
        except Exception as e:
            self.logger.error("Erro na escuta: %s" % e)
        finally:
            self._parar_escuta()
        return resposta
    def _perguntar(self, chave):
        self._falar(self.FRASES[chave])
        return self._ouvir_sim_nao()
    # ==================== HAPPY: HIGH FIVE ====================
    def _reagir_happy(self):
        self._falar(self.FRASES["happy"])
        self.memory.insertData("HighFive/OK", 0)
        self._animar(self.onHighFive, "High Five")
        try:
            ok = self.memory.getData("HighFive/OK")
        except Exception:
            ok = 0
        if ok == 1:
            self._falar(self.FRASES["happy_fim"])
            self._animar(self.onCelebrate, "Comemoracao")
        else:
            self._falar(self.FRASES["happy_sem"])
    # ==================== ANGRY: RESPIRACAO ====================
    def _respirar(self):
        for i in range(self.respiracoes):
            if not self.running:
                return
            self._falar(self.FRASES["inspira"])
            time.sleep(self.tempo_inspira)
            self._falar(self.FRASES["expira"])
            time.sleep(self.tempo_expira)
    def _reagir_angry(self):
        self.leds.fadeRGB("FaceLeds", self.cor_calma, 0.5)
        try:
            self._falar(self.FRASES["angry"])
            for rodada in range(self.max_rodadas):
                if not self.running:
                    return
                self._respirar()
                resp = self._perguntar("angry_pergunta")
                if resp == "yes":
                    self._falar(self.FRASES["angry_sim"])
                    return
                # "no" ou sem resposta: oferece o Tai Chi
                resp = self._perguntar("angry_taichi")
                if resp == "yes":
                    self._falar(self.FRASES["angry_taichi_s"])
                    self._animar(self.onTaiChi, "Tai Chi")
                    return
                # recusou o Tai Chi: repete a respiracao (se ainda houver rodada)
                if rodada < self.max_rodadas - 1:
                    self._falar(self.FRASES["angry_repetir"])
            self._falar(self.FRASES["angry_fim"])
        finally:
            self.leds.fadeRGB("FaceLeds", 0xFFFFFF, 0.5)
    # ==================== SAD ====================
    def _reagir_sad(self):
        resp = self._perguntar("sad_pergunta")
        if resp == "yes":
            self._falar(self.FRASES["sad_sim"])
            self._animar(self.onSaxophone, "Saxophone")
        elif resp == "no":
            self._falar(self.FRASES["sad_nao"])
        else:
            self._falar(self.FRASES["nada"])
    # ==================== REACOES ====================
    def _reagir(self, label):
        self.logger.info("Detected expression: " + label)
        self.ultima_reacao[label] = time.time()
        if label == "happiness":
            self._reagir_happy()
        elif label == "neutral":
            resposta = self._perguntar("neutral")
            if resposta == "yes":
                self._falar("Great! Let's talk.")
                self.logger.info("Neutral: YES -> switching to LLM_CHAT")
                # O loop principal faz a limpeza ANTES de disparar onLLM.
                self.ir_para_llm = True
                self.running = False
            elif resposta == "no":
                self._falar("Okay! I'll keep recognizing your emotions.")
                self.logger.info("Neutral: NO -> continuing emotion recognition")
            else:
                self._falar("I didn't catch that. I'll keep recognizing your emotions.")
                self.logger.info("Neutral: no answer -> continuing emotion recognition")
        elif label == "surprise":
            self._falar(self.FRASES["surprise"])
            self._falar(self.FRASES["surprise2"])
            self._animar(self.onThinking, "Thinking")
        elif label == "anger":
            self._reagir_angry()
        elif label == "sadness":
            self._reagir_sad()
    # ==================== CAMERA E CNN ====================
    def _achar_logitech(self):
        import glob, os
        for p in sorted(glob.glob("/sys/class/video4linux/video*")):
            try:
                nome = open(p + "/name").read()
                idx = open(p + "/index").read().strip()
            except Exception:
                continue
            if "C930e" in nome and idx == "0":
                return int(os.path.basename(p).replace("video", ""))
        return None
    def _iniciar_servidor(self):
        subprocess.call(["pkill", "-f", "servidor_emocao"])
        time.sleep(0.5)
        self.servidor = subprocess.Popen(
            ["/usr/bin/python", self.SERVIDOR],
            stdout=open(self.LOG_SERV, "w"),
            stderr=subprocess.STDOUT)
        for i in range(20):
            if self.servidor.poll() is not None:
                self.logger.error("Servidor fechou! Veja %s" % self.LOG_SERV)
                return False
            try:
                self.sock.sendto("ping", ("127.0.0.1", self.PORTA))
                data, _ = self.sock.recvfrom(64)
                if data == "pong":
                    return True
            except Exception:
                pass
            time.sleep(1)
        self.logger.error("Servidor nao respondeu. Veja %s" % self.LOG_SERV)
        return False
    def _classificar(self, rosto64):
        try:
            self.sock.sendto(rosto64.tostring(), ("127.0.0.1", self.PORTA))
            data, _ = self.sock.recvfrom(1024)
            probs = [float(v) for v in data.split()]
        except Exception as e:
            self.logger.warning("Servidor: %s" % e)
            return None, 0.0
        filtradas = {}
        for i, nome in enumerate(self.LABELS):
            if nome in self.PERMITIDAS:
                filtradas[nome] = probs[i]
        total = sum(filtradas.values())
        if total <= 0:
            return None, 0.0
        melhor = max(filtradas, key=filtradas.get)
        return melhor, filtradas[melhor] / total
    # ==================== PRINCIPAL ====================
    def onInput_onStart(self):
        if self.running:
            return
        self.running = True
        self.ir_para_llm = False
        import cv2
        self.tts.setLanguage("English")
        num = self._achar_logitech()
        if num is None:
            self._falar("USB camera not connected")
            self.running = False
            self.onStopped()
            return
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.settimeout(1.0)
        if not self._iniciar_servidor():
            self._falar("Emotion server error")
            self.onUnload()
            self.onStopped()
            return
        rosto_det = cv2.CascadeClassifier(self.PASTA + "haarcascade_frontalface_default.xml")
        self.cap = cv2.VideoCapture(num + cv2.CAP_V4L2)
        self.logger.info("CAMERA ABERTA: %s" % self.cap.isOpened())
        self.cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*'MJPG'))
        self.cap.set(3, 640)
        self.cap.set(4, 480)
        self.logger.info("Pronto. Emocoes: %s" % ", ".join(self.PERMITIDAS))
        self._falar("Hello! I am ready to recognize your emotions.")
        ultima = None
        contagem = 0
        neutral_desde = None   # quando comecou o neutral continuo
        sem_rosto_desde = None  # inicio da interrupcao na deteccao
        try:
            while self.running:
                ok, frame = self.cap.read()
                if not ok or frame is None:
                    self.logger.warning("ERRO: camera nao entrega frames")
                    time.sleep(2)
                    continue
                cinza = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
                rostos = rosto_det.detectMultiScale(cinza, 1.3, 5)
                if len(rostos) == 0:
                    contagem = 0
                    if sem_rosto_desde is None:
                        sem_rosto_desde = time.time()
                    if time.time() - sem_rosto_desde > self.tolerancia_sem_rosto:
                        neutral_desde = None
                    time.sleep(0.1)
                    continue
                sem_rosto_desde = None
                x, y, w, h = max(rostos, key=lambda r: r[2] * r[3])
                rosto64 = cv2.resize(cinza[y:y + h, x:x + w], (64, 64))
                label, conf = self._classificar(rosto64)
                if label is None:
                    time.sleep(0.5)
                    continue
                self.logger.info("CNN: %s (%.0f%%)" % (label, conf * 100))
                if conf < self.confianca:
                    contagem = 0
                    continue
                if label == ultima:
                    contagem += 1
                else:
                    ultima = label
                    contagem = 1
                # ----- NEUTRAL: so reage se ficar neutral por muito tempo -----
                if label == "neutral":
                    if neutral_desde is None:
                        neutral_desde = time.time()
                    if time.time() - neutral_desde < self.tempo_neutral:
                        time.sleep(0.1)
                        continue
                else:
                    neutral_desde = None
                    if contagem < self.estabilidade:
                        time.sleep(0.1)
                        continue
                # cooldown: nao repete a mesma emocao muito rapido
                desde = time.time() - self.ultima_reacao.get(label, 0)
                if desde < self.COOLDOWN.get(label, 0):
                    contagem = 0
                    continue
                # ===== REACAO (o loop espera ela terminar) =====
                self._reagir(label)
                if self.ir_para_llm:
                    break  # sai do loop, libera recursos e so entao inicia LLM
                # descanso e descarta imagens antigas da camera
                fim = time.time() + self.pausa_depois
                while self.running and time.time() < fim:
                    self.cap.read()
                    time.sleep(0.05)
                ultima = None
                contagem = 0
                neutral_desde = None
        finally:
            self.onUnload()  # encerra a camera, o socket e o servidor CNN
        if self.ir_para_llm:
            self.logger.info("TESTE parado. Disparando saida onLLM")
            self.ir_para_llm = False
            self.onLLM()  # criar esta saida tipo bang no Choregraphe
    def onInput_onStop(self):
        self.onUnload()
        self.onStopped()]]>
                </content>
              </script>
              <Input name="onLoad" type="1" type_size="1" nature="0" inner="1" tooltip="Signal sent when diagram is loaded." id="1" />
              <Input name="onStart" type="1" type_size="1" nature="2" inner="0" tooltip="Box behavior starts when a signal is received on this input." id="2" />
              <Input name="onStop" type="1" type_size="1" nature="3" inner="0" tooltip="Box behavior stops when a signal is received on this input." id="3" />
